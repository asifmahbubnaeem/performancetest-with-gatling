# Copy to .env and fill in for your EC2 deployment. Never commit the real .env.
# See ../README.md and the isaraadvance docker-compose-simple.yml for
# authoritative service/network/DB naming.

# --- Host port remaps (avoid colliding with other services on the box) ---
PROM_PORT=9000
GRAFANA_PORT=8443
CADVISOR_PORT=8081
PGEXPORTER_PORT=9187
AUDIT_PGEXPORTER_PORT=9188

GRAFANA_ADMIN_PASSWORD=changeme

# --- App network to join so postgres-exporter can reach postgres by name ---
# The isaraadvance compose project sets `name: isaraadvance` with no explicit
# network on the postgres/audit-postgres services, so this is their implicit
# default network:
APP_NETWORK=isaraadvance_default

# --- Main advance DB pool (DATABASE_POOL_MAX, default 25) ---
# setup.sh creates/updates PG_MONITOR_USER for you (GRANT pg_monitor) — no
# manual SQL needed, just set the values here first.
# PG_SUPERUSER: the postgres image makes its superuser role AS whatever
# POSTGRES_USER (DATABASE_ADMIN_USER in the isaraadvance .env) was set to at
# initdb — this varies per deployment (docker-compose-simple.yml's own
# default is advance_admin_login, but the running box may override it, e.g.
# to plain "postgres"). There is no safe default here — verify with:
#   docker exec <container-name> env | grep -i POSTGRES_USER
# setup.sh will refuse to run with this unset rather than guess wrong.
# PG_CONTAINER_NAME: docker-compose-simple.yml sets no container_name, so
# Compose v2 names it "<project>-<service>-<index>" (project name
# "isaraadvance" from that file's `name:` field) — NOT the bare service name.
# Confirm with `docker ps --format '{{.Names}}'` on the target box.
PG_CONTAINER_NAME=isaraadvance-postgres-1
PG_SUPERUSER=  # e.g. postgres — verify, do not assume
PG_DATABASE=advance
PG_MONITOR_USER=perf_monitor
PG_MONITOR_PASSWORD=changeme
PG_SSLMODE=require

# --- Audit DB pool (AUDIT_DATABASE_POOL_MAX, default 20) ---
# Separate Postgres cluster (audit-postgres service). Same superuser and
# container-naming caveats as above apply independently here — the audit
# cluster's POSTGRES_USER may differ from the main one's, verify both.
# setup.sh provisions the monitor role on this cluster too. Monitor
# user/password/sslmode default to the main creds above if you provision
# the same role/password on both clusters; override if not.
AUDIT_PG_CONTAINER_NAME=isaraadvance-audit-postgres-1
AUDIT_PG_SUPERUSER=  # e.g. postgres — verify, do not assume
AUDIT_PG_DATABASE=audit_logs
# AUDIT_PG_MONITOR_USER=perf_monitor
# AUDIT_PG_MONITOR_PASSWORD=changeme
# AUDIT_PG_SSLMODE=require
